# OANDA v20 credentials. Copy this file to .env and replace the placeholders.
# Never commit the real .env file or share the API token.
OANDA_API_TOKEN=replace_with_your_personal_access_token
OANDA_ACCOUNT_ID=replace_with_your_v20_account_id
OANDA_ENV=practice

# V0.3 official macro APIs. FRED requires a personal API key. BLS accepts
# limited requests without a key; set BLS_API_KEY for registered limits.
FRED_API_KEY=84cb6fe7d6f457d44f5d31ee243d5bde
BLS_API_KEY=
